FROM python:3.13-slim-bookworm

# Copy uv binaries from the official Astral image instead of running the shell installer.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Install uv and system dependencies required during environment creation.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && \
	apt-get clean && \
	rm -rf /var/lib/apt/lists/*

WORKDIR /home/
COPY .build_workspace/environments/requirements_dev.txt .build_workspace/environments/create_dev_env.sh ./
RUN /bin/bash -c "source create_dev_env.sh"

RUN git config --global core.editor "code --wait"

CMD ["/bin/sh", "-c", "bash"]